# ===== Supabase (Project Settings -> API) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ===== AI (chỉ dùng phía server, KHÔNG có tiền tố NEXT_PUBLIC) =====
# anthropic | openai
AI_PROVIDER=anthropic
# Để trống = dùng model mặc định (anthropic: claude-sonnet-5-5, openai: gpt-4.1)
AI_MODEL=
ANTHROPIC_API_KEY=
# Bắt buộc nếu AI_PROVIDER=openai. Nếu dùng Claude, key này vẫn NÊN có để tạo embedding (tìm kiếm ngữ nghĩa).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
